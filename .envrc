# Some flake inputs are fetched from GitHub; a token avoids API rate limits.
# It must be set before `use flake`, since locking the flake happens before the
# devshell exists. Reuses the gh CLI login instead of an access-tokens entry in nix.conf.
if github_token="$(gh auth token 2>/dev/null)" && [[ -n "$github_token" ]]; then
  export NIX_CONFIG="extra-access-tokens = github.com=$github_token${NIX_CONFIG:+$'\n'$NIX_CONFIG}"
  log_status "GitHub token loaded for flake inputs."
else
  log_error "No GitHub token found. Run 'gh auth login' and 'direnv reload'."
fi
unset github_token

# Age identity for repo secrets: the first ~/.ssh key listed in master-identity.nix.
# Set AGE_IDENTITY yourself to override (e.g. a decrypted master.age for break-glass).
if [[ -z "${AGE_IDENTITY:-}" ]]; then
  for pub in "$HOME"/.ssh/*.pub; do
    [[ -e "$pub" ]] || continue
    if grep -qF "\"$(cut -d' ' -f1,2 "$pub")\"" secrets/master-identity.nix; then
      export AGE_IDENTITY="${pub%.pub}"
      break
    fi
  done
fi
if [[ -n "${AGE_IDENTITY:-}" ]]; then
  log_status "Age identity: $AGE_IDENTITY"
else
  log_error "No ~/.ssh key listed in secrets/master-identity.nix; secrets can't be decrypted."
fi
watch_file secrets/master-identity.nix

use flake
watch_file devshell.nix secrets/tofu-tokens/tokens.json.age
